{
  "description": "Test case definitions for per-step evaluations. Each expected item is matched when ANY keyword in anyOf appears (case-insensitive substring) in the relevant output field of the evaluated step.",
  "fixtures": [
    {
      "fixture": "fixtures/hvac-ticket-1.md",
      "evidenceFile": "evidence/ticket1-run.json",
      "baselineEvidenceFile": "evidence/run1/ticket1-run.json",
      "requirementInterpreter": {
        "expectedBusinessRules": [
          {
            "id": "t1-r1",
            "expectation": "DX Coil Height equals the sum of all Cooling Circuit heights",
            "anyOf": ["sum of", "summed", "summing"]
          },
          {
            "id": "t1-r2",
            "expectation": "Cooling Circuits are populated when a Cooling Package is entered",
            "anyOf": ["cooling package"]
          },
          {
            "id": "t1-r3",
            "expectation": "Editing a circuit height recalculates and updates the DX Coil Height",
            "anyOf": ["recalculat", "react", "updated"]
          }
        ],
        "expectedHvacTerms": [
          "DX Coil",
          "Cooling Circuit",
          "Cooling Package",
          "R-454B",
          "Circuit Height",
          "DX Coil Information"
        ],
        "expectedAmbiguities": [
          {
            "id": "t1-a1",
            "expectation": "No validation rules for circuit heights are defined",
            "anyOf": ["validation"]
          },
          {
            "id": "t1-a2",
            "expectation": "Units of measurement are not defined",
            "anyOf": ["unit"]
          },
          {
            "id": "t1-a3",
            "expectation": "Behavior when circuits are added or removed after initial load is unclear",
            "anyOf": ["added or removed", "add or remove", "added/removed", "removed"]
          },
          {
            "id": "t1-a4",
            "expectation": "Source/format of initial circuit data is unspecified",
            "anyOf": ["source", "initial"]
          }
        ]
      },
      "adversarialReviewer": {
        "expectedUnsupportedAssumptions": [
          {
            "id": "t1-ua1",
            "expectation": "Interpreter assumes validation behavior the ticket does not specify",
            "anyOf": ["validation", "numeric"]
          }
        ],
        "expectedMissingRequirements": [
          {
            "id": "t1-mr1",
            "expectation": "Missing validation rules (range, precision, format) for circuit heights",
            "anyOf": ["validation", "range", "precision"]
          },
          {
            "id": "t1-mr2",
            "expectation": "Missing handling for dynamic circuit add/remove",
            "anyOf": ["added or removed", "dynamic", "add or remove", "removed"]
          }
        ]
      },
      "finalReviewWriter": {
        "mustContainDisposition": true
      }
    },
    {
