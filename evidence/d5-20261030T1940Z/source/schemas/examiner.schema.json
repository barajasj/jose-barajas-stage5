{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirementSummary",
    "hvacTerminology",
    "businessRules",
    "developerConsiderations",
    "ambiguities",
    "confidence"
  ],
  "properties": {
    "requirementSummary": {
      "type": "string",
      "pattern": "\\S"
    },
    "hvacTerminology": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "developerConsiderations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "ambiguityResolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ambiguity", "rationale", "sourceQuote"],
        "properties": {
          "ambiguity": { "type": "string", "pattern": "\\S" },
          "rationale": { "type": "string", "pattern": "\\S" },
          "sourceQuote": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    }
  }
}