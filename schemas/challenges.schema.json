{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "findings",
    "rationale",
    "resolutions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "rationale": {
      "type": "string",
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "kind",
          "description",
          "action",
          "sourceRefs",
          "ambiguityRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": ["UNSUPPORTED_ASSUMPTION", "MISSING_REQUIREMENT", "HVAC_ERROR", "MISSING_VALIDATION", "OPEN_AMBIGUITY"]
          },
          "action": {
            "type": "string",
            "pattern": "\\S"
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          },
          "ambiguityRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/ambiguities/(0|[1-9][0-9]*)$"
            }
          }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "rationale", "sourceRefs"],
        "properties": {
          "findingId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "rationale": { "type": "string", "pattern": "\\S" },
          "sourceRefs": { "$ref": "#/definitions/sourceRefs" }
        }
      }
    }
  },
  "definitions": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "pointer", "quote"],
        "properties": {
          "artifact": { "enum": ["ticket", "interpreter"] },
          "pointer": { "type": "string" },
          "quote": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } } },
      "then": { "properties": { "findings": { "type": "array", "maxItems": 0 } } },
      "else": { "properties": { "findings": { "type": "array", "minItems": 1 } } }
    }
  ]
}